#add for board init.rc for recovery mode
import /init.recovery.common.rc

on init
    write /sys/fs/selinux/enforce 0 #force permissive
    write /sys/class/power_supply/usb/otg_switch 1 #enable otg
    start load_flashlight_modules
    start prepdecrypt 
        
on boot
    install_keyring
    start keymint-1-0
    start gatekeeper-1-0
    start boot-hal-1-1
    start health-hal-2-1

on property:vendor.sys.listener.registered=true
    start keymint-1-0
    start gatekeeper-1-0

on property:crypto.ready=1 && property:ro.crypto.state=encrypted
    start keymint-1-0
    start gatekeeper-1-0

on property:crypto.ready=1 && property:hwservicemanager.ready=true
    start keymint-1-0
    start gatekeeper-1-0

on property:ro.crypto.state=unsupported
    stop keymint-1-0
    stop gatekeeper-1-0

on property:ro.crypto.state=unencrypted
    stop keymint-1-0
    stop gatekeeper-1-0

on property:twrp.decrypt.done=true
    stop keymint-1-0
    stop gatekeeper-1-0

service prepdecrypt /system/bin/prepdecrypt.sh
    oneshot
    disabled
    user root
    group root
    seclabel u:r:recovery:s0    

service keymint-1-0 /system/bin/hw/android.hardware.security.keymint@1.0-unisoc.service
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /system/bin/hw/android.hardware.gatekeeper@1.0-service.trusty
    user root
    group root
    disabled
    seclabel u:r:recovery:s0


service load_flashlight_modules /system/bin/load_flashlight_modules.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
